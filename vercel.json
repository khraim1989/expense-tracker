{
  "buildCommand": "npm install && npm run build",
  "devCommand": "npm start",
  "framework": "create-react-app",
  "outputDirectory": "build",
  "env": {
    "PUBLIC_URL": "./"
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ]
}

